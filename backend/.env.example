# Server Port
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas URI or local instance)
# Can use template with <db_username> and <db_password> or direct connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@daymark.wn6pn8z.mongodb.net/daymark?retryWrites=true&w=majority&appName=Daymark
DB_USERNAME=your_mongodb_username
DB_PASSWORD=your_mongodb_password
DB_NAME=daymark

# Secret key used for signing JWT tokens (Required in production)
JWT_SECRET=replace_with_a_long_random_secret_key_in_production

# Runtime Environment: 'development' or 'production'
NODE_ENV=development

# Allowed CORS origins in production (comma-separated, or * for open access)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
